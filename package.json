{
  "name": "@lorenzh/pulse-config",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Shared tooling configuration for the pulse repositories.",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  },
  "bin": {
    "pulse-eslint": "./bin/pulse-eslint.js"
  },
  "files": [
    "bin/pulse-eslint.js",
    "biome.json",
    "tsconfig.base.json",
    "eslint.config.js",
    "lefthook.yml",
    ".github/workflows/check.yml"
  ],
  "exports": {
    "./biome.json": "./biome.json",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./eslint.config.js": "./eslint.config.js",
    "./lefthook.yml": "./lefthook.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "bun node_modules/typescript7/bin/tsc --noEmit",
    "test": "bun test src",
    "lint": "biome check . && bun bin/pulse-eslint.js --config eslint.local.config.js .",
    "format": "biome check --write .",
    "prepare": "lefthook install || true",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@types/bun": "1.4.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "10.13.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^26.6.5",
    "lefthook": "2.2.2",
    "typescript7": "npm:typescript@^7.0.2"
  }
}
