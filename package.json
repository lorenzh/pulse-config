{
  "name": "@lorenzh/pulse-config",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Shared tooling configuration for the pulse repositories.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-exclude=\"**/*.test.ts\" --test-coverage-exclude=\"**/test/**\" --test-coverage-exclude=\"dist/**\"",
    "lint": "biome check . && node tools/sonarjs/node_modules/eslint/bin/eslint.js --config tools/sonarjs/eslint.config.js .",
    "format": "biome check --write .",
    "prepare": "lefthook install || true",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^26.6.5",
    "lefthook": "2.2.2",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "tools/sonarjs"
  ]
}
